<odoo>
    <!-- make sure to call it from the manifest file  -->
    <!-- list view for template.manyone model -->
    <record id="list_view_template_manyone" model="ir.ui.view">
        <field name="name">template.manyone.list</field>
        <field name="model">template.manyone</field>
        <field name="arch" type="xml">
            <list string="ManyOne List View">
                <field name="name" />
            </list>
        </field>
    </record>

    <!--  form view for template.manyone model -->
    <record id="form_view_template_manyone" model="ir.ui.view">
        <field name="name">template.manyone.form</field>
        <field name="model">template.manyone</field>
        <field name="arch" type="xml">
            <form string="ManyOne Form View">
                <sheet>
                    <h1>
                        <field name="name" placeholder="Name" />
                    </h1>
                    <group>
                        <field name="template_ids" />
                    </group>

                </sheet>

            </form>
        </field>
    </record>
    <!-- actions  -->
    <record id="action_template_manyone" model="ir.actions.act_window">
        <field name="name">ManyOne</field>
        <field name="res_model">template.manyone</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>   